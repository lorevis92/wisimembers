# ---------- Frontend (variabili VITE_ visibili nel browser) ----------
# Se lasci vuote le due variabili Supabase l'app parte in MODALITA DEMO con dati finti.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Link allo shop (pulsante "Non hai un codice?")
VITE_SHOP_URL=https://wisiverse.com

# ---------- Backend (solo su Vercel, MAI nel repo e MAI con prefisso VITE_) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=WiSiVERSE <noreply@wisiverse.com>
# Email che riceve gli avvisi (nuovi ritrovamenti, passaggi, ordini non riconosciuti)
ADMIN_EMAIL=
# Indirizzo pubblico dell'app (usato nei link delle email)
SITE_URL=https://members.wisiverse.com
# Una stringa lunga e casuale: protegge il webhook di Printful (va messa nell'URL)
PRINTFUL_WEBHOOK_SECRET=
# Token privato Printful (serve solo allo script scripts/printful-webhook.mjs)
PRINTFUL_API_TOKEN=
# Una stringa lunga e casuale: protegge /api/cron (Vercel la invia da solo come Bearer)
CRON_SECRET=
